<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EnjayCallSync" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="android:windowBackground">@color/surface_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="toolbarStyle">@style/Widget.Enjay.Toolbar</item>
        <item name="chipStyle">@style/Widget.Enjay.StatusChip</item>
        <item name="materialButtonStyle">@style/Widget.Enjay.SecondaryButton</item>
        <item name="textInputStyle">@style/Widget.Enjay.TextInputLayout</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Enjay.HeadlineSmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Enjay.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Enjay.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Enjay.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Enjay.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Enjay.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Enjay.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Enjay.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Enjay.LabelMedium</item>
    </style>

    <style name="TextAppearance.Enjay.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Enjay.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Enjay.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Enjay.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Enjay.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Enjay.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Enjay.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Enjay.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Enjay.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Enjay.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface_app</item>
        <item name="titleTextAppearance">@style/TextAppearance.Enjay.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Enjay.ToolbarSubtitle</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Enjay.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">27sp</item>
    </style>

    <style name="TextAppearance.Enjay.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Enjay.StatusChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">50dp</item>
        <item name="chipBackgroundColor">@color/primary_container</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="chipIconVisible">false</item>
    </style>

    <style name="Widget.Enjay.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>

    </style>

    <style name="Widget.Enjay.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Enjay.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Enjay.PopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
    </style>

</resources>
