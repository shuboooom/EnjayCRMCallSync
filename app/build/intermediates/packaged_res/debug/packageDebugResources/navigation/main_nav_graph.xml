<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/permissionsFragment">

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="com.enjay.crm.callsync.ui.permissions.PermissionsFragment"
        android:label="@string/title_permissions">
        <action
            android:id="@+id/action_permissionsFragment_to_callsFragment"
            app:destination="@id/callsFragment"
            app:popUpTo="@id/permissionsFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/callsFragment"
        android:name="com.enjay.crm.callsync.ui.calls.CallsFragment"
        android:label="@string/tab_calls" />

    <fragment
        android:id="@+id/leadsFragment"
        android:name="com.enjay.crm.callsync.ui.leads.LeadsFragment"
        android:label="@string/tab_leads">
        <action
            android:id="@+id/action_leadsFragment_to_addLeadFragment"
            app:destination="@id/addLeadFragment" />
        <action
            android:id="@+id/action_leadsFragment_to_leadDetailFragment"
            app:destination="@id/leadDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.enjay.crm.callsync.ui.more.MoreFragment"
        android:label="@string/tab_more" />

    <fragment
        android:id="@+id/addLeadFragment"
        android:name="com.enjay.crm.callsync.ui.leads.AddLeadFragment"
        android:label="@string/title_add_lead" />

    <fragment
        android:id="@+id/leadDetailFragment"
        android:name="com.enjay.crm.callsync.ui.leads.LeadDetailFragment"
        android:label="@string/title_lead_detail" />

    <fragment
        android:id="@+id/postCallDetailFragment"
        android:name="com.enjay.crm.callsync.ui.postcall.PostCallDetailFragment"
        android:label="@string/title_post_call_detail" />
</navigation>
